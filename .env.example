# GEMINI_API_KEY: Required for Gemini AI API calls (Smart Farming Assistant, Plant Disease Vision, Multilingual Translation).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENWEATHER_API_KEY: Optional OpenWeatherMap API key for live weather forecasts.
# If omitted, the app automatically falls back to Open-Meteo live weather or manual environmental input.
OPENWEATHER_API_KEY=""

# SESSION_SECRET: Secret for signing authentication session tokens.
SESSION_SECRET="agrisense-local-dev-secret-change-in-production"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"
